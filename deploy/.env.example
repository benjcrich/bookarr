# Copy to .env next to docker-compose.yml, then: docker compose up -d
#
# Settings precedence:
#   UI/DB (Admin → Settings) > env bootstrap (first boot only) > defaults
# Secrets can be set here for first deploy; after that, edit/clear in the UI.
# Compose-only (not in Settings UI): BOOKARR_TAG, BOOKARR_PORT, volume mounts, BOOKARR_DB_PATH.

BOOKARR_TAG=latest
BOOKARR_PORT=8787

# Persistence (compose named volume bookarr-data → /data)
# BOOKARR_DB_PATH and BOOKARR_LIBRARY_ROOT are set in compose.

# --- Optional first-boot bootstrap (UI wins after save) ---

# Indexers
PROWLARR_URL=
PROWLARR_API_KEY=

# Download clients: mock | auto
DOWNLOAD_CLIENT_MODE=mock
QBITTORRENT_URL=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
QBITTORRENT_CATEGORY=bookarr
SABNZBD_URL=
SABNZBD_API_KEY=
SABNZBD_CATEGORY=bookarr

# Metadata: auto | mock
METADATA_MODE=auto
HARDCOVER_API_KEY=
METADATA_CACHE_TTL_HOURS=24

BOOKARR_DOWNLOAD_POLL_MS=3000
BOOKARR_MOCK_DOWNLOAD_MS=1500
