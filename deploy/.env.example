# Copy to .env next to docker-compose.yml, then: docker compose up -d
BOOKARR_TAG=latest
BOOKARR_PORT=8787

# Persistence (compose named volume bookarr-data → /data)
# BOOKARR_DB_PATH and BOOKARR_LIBRARY_ROOT are set in compose.

# Indexers
PROWLARR_URL=
PROWLARR_API_KEY=

# Download clients: mock | auto
DOWNLOAD_CLIENT_MODE=mock
QBITTORRENT_URL=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
QBITTORRENT_CATEGORY=bookarr
SABNZBD_URL=
SABNZBD_API_KEY=
SABNZBD_CATEGORY=bookarr

# Metadata: auto | mock
METADATA_MODE=auto
HARDCOVER_API_KEY=
METADATA_CACHE_TTL_HOURS=24

BOOKARR_DOWNLOAD_POLL_MS=3000
