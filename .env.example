# Bookarr — local / docker-compose (build) template
#
# Settings precedence:
#   1) Values saved in Admin → Settings (SQLite) — win for normal operation
#   2) Env vars below — bootstrap missing keys on first boot only (INSERT OR IGNORE)
#   3) Built-in defaults
#
# Compose/process-only (never UI): PORT, HOST, BOOKARR_DB_PATH, volume mounts.

PORT=8787
HOST=0.0.0.0
BOOKARR_DB_PATH=./data/bookarr.db

# --- Bootstrap into SQLite (edit later in Admin → Settings) ---
BOOKARR_LIBRARY_ROOT=./data/audiobooks
# libraryDirect = client saves into library (no copy/move). Aliases: none, client-to-library
# BOOKARR_IMPORT_MODE=libraryDirect
BOOKARR_DOWNLOAD_POLL_MS=3000
# Mock download completes after this many ms (tests/dev)
BOOKARR_MOCK_DOWNLOAD_MS=1500

# Prowlarr (leave empty to use built-in mock indexers/search)
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
# Optional search filters (comma-separated; empty = no filter / all indexers)
# PROWLARR_INDEXER_IDS=1,4
# PROWLARR_CATEGORIES=3030

# Logging: info (quiet) | debug (HTTP access lines) | warn | error
LOG_LEVEL=info

# Docker only: app user for /data ownership (entrypoint chowns then drops privileges)
# PUID=1000
# PGID=1000

# Download clients: mock | auto (auto uses live clients when URLs/keys are set)
DOWNLOAD_CLIENT_MODE=mock

# qBittorrent (torrent)
QBITTORRENT_URL=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
QBITTORRENT_CATEGORY=bookarr

# SABnzbd (usenet)
SABNZBD_URL=
SABNZBD_API_KEY=
SABNZBD_CATEGORY=bookarr

# Metadata: auto (Open Library + optional Hardcover) | mock
METADATA_MODE=auto
HARDCOVER_API_KEY=
METADATA_CACHE_TTL_HOURS=24
